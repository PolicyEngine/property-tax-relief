    "kind": "deduction",
    "inputs": [
      {
        "variable": "real_estate_taxes",
        "label": "Eligible 2025 real estate taxes paid",
        "entity": "person",
        "kind": "money",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Use the qualifying real estate taxes for one home from 2025 Schedule M1SA line 5."
      },
      {
        "variable": "mn_personal_property_taxes",
        "label": "Eligible 2025 personal property taxes",
        "entity": "person",
        "kind": "money",
        "minimum": 0,
        "maximum": 0,
        "description": "Enter $0 for this real-estate-only estimate. This is Schedule M1SA line 6."
      }
    ],
    "notes": [
      "This estimate covers one Minnesota homeowner filing singly in 2025, with zero eligible personal property taxes."
    ],
    "resultLabel": "Real estate taxes allowed under Minnesota itemization",
