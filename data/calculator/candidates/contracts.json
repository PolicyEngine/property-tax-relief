  {
    "id": "ri-property-tax-relief",
    "state": "RI",
    "name": "Property Tax Relief Claim (RI-1040H)",
    "year": 2025,
    "modelVariable": "ri_property_tax_credit",
    "entity": "tax_unit",
    "kind": "credit",
    "inputs": [
      {
        "variable": "age",
        "label": "Age on December 31, 2025",
        "entity": "person",
        "kind": "number",
        "minimum": 65,
        "maximum": 120
      },
      {
        "variable": "ri_property_tax_household_income",
        "label": "2025 household income from RI-1040H line 32",
        "entity": "tax_unit",
        "kind": "money",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Use line 32 of Form RI-1040H. Include all sources that the form counts."
      },
      {
        "variable": "real_estate_taxes",
        "label": "2025 qualifying tax on your main home",
        "entity": "person",
        "kind": "money",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Use Form RI-1040H line 2. Exclude any tax paid with public assistance."
      },
      {
        "variable": "rent",
        "label": "2025 rent for your main home or its land",
        "entity": "person",
        "kind": "money",
        "minimum": 0,
        "maximum": 0,
        "description": "Enter $0 for this homeowner estimate, which covers a home and land you own."
      }
    ],
    "notes": [
      "This estimate covers one homeowner age 65 or older who lived alone and was domiciled in Rhode Island throughout 2025. It covers a taxable primary home and current payments for 2025 and prior years."
    ],
    "resultLabel": "Rhode Island homeowner property tax credit",
    "resultNote": "This is the homeowner amount from RI-1040H line 6, which flows to line 13 and may increase your refund.",
