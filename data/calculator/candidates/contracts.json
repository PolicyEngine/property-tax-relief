  {
    "id": "vt-renter-credit",
    "state": "VT",
    "name": "Renter Credit",
    "year": 2025,
    "modelVariable": "vt_renter_credit",
    "entity": "tax_unit",
    "kind": "credit",
    "inputs": [
      {
        "variable": "county",
        "label": "County of your Vermont rental",
        "entity": "household",
        "kind": "select",
        "options": [
          {
            "value": "ADDISON_COUNTY_VT",
            "label": "Addison County"
          },
          {
            "value": "CHITTENDEN_COUNTY_VT",
            "label": "Chittenden County"
          }
        ],
        "description": "Use the county where you rented at the end of 2025, or the last county where you rented in 2025."
      },
      {
        "variable": "vt_renter_credit_domicile_status",
        "label": "Did you live in Vermont as your permanent home all year?",
        "entity": "tax_unit",
        "kind": "select",
        "options": [
          {
            "value": "FULL_YEAR",
            "label": "Yes"
          },
          {
            "value": "NOT_FULL_YEAR",
            "label": "No"
          }
        ],
        "description": "Use your answer to RCC-146 line 2 for all of calendar year 2025."
      },
      {
        "variable": "vt_renter_credit_months_rented",
        "label": "Qualifying months rented in Vermont in 2025",
        "entity": "tax_unit",
        "kind": "integer",
        "minimum": 0,
        "maximum": 12,
        "description": "Use the number of distinct calendar months from RCC-146 line 7. The months can be nonconsecutive."
      },
      {
        "variable": "claimed_as_dependent_on_another_return",
        "label": "Did another taxpayer claim you as a dependent for 2025?",
        "entity": "person",
        "kind": "boolean",
        "description": "Use your answer to RCC-146 line 3."
      },
      {
        "variable": "vt_renter_credit_income",
        "label": "2025 countable income from RCC-146 line 14",
        "entity": "tax_unit",
        "kind": "money",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Use total countable income from the Vermont form."
      },
      {
        "variable": "rent",
        "label": "Eligible 2025 rent you paid",
        "entity": "person",
        "kind": "money",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Enter rent you paid for the qualifying Vermont dwelling."
      },
      {
        "variable": "housing_assistance",
        "label": "2025 rental housing assistance received",
        "entity": "spm_unit",
        "kind": "money",
        "minimum": 0,
        "maximum": 0,
        "description": "Enter $0 for this unsubsidized renter estimate."
      }
    ],
    "notes": [
      "This preview covers a single adult renting an unsubsidized, unshared home in Addison or Chittenden County. It covers a taxable dwelling without business-use proration or another state’s homestead credit.",
      "Positive estimates apply to renters who are eligible for their own personal exemption. The model also checks the actual dependent claim recorded on RCC-146."
    ],
    "resultLabel": "Vermont renter credit",
    "resultNote": "The model uses the county’s one-bedroom fair market rent and the reported rental months and income.",
    "sourceEvidence": {
      "packageVersion": "2.145.3+preview.d1e89b3.a7d375c.c817a3f.af67c29",
      "file": "variables/gov/states/vt/tax/income/credits/renter/vt_renter_credit.py",
      "sha256": "fedb0ef8cec11cc54b2baf55cc03256dbdd2e1fcefa982447f37313c1abf0001"
    },
    "sources": [
      {
        "title": "2025 Vermont RCC-146 renter credit claim",
        "url": "https://tax.vermont.gov/sites/tax/files/documents/RCC-146-2025.pdf"
      },
      {
        "title": "32 V.S.A. § 6066(b) and (c)",
        "url": "https://legislature.vermont.gov/statutes/section/32/154/06066"
      },
      {
        "title": "2025 Vermont renter credit amounts",
        "url": "https://tax.vermont.gov/individuals/renter-credit/calculator-and-credit-amounts"
      },
      {
        "title": "2025 Vermont income booklet county limits",
        "url": "https://tax.vermont.gov/sites/tax/files/documents/Income-Booklet-2025.pdf#page=37"
      }
    ]
  },
